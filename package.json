{
  "name": "emily-reif-website",
  "version": "0.1.0",
  "description": "",
  "license": "Apache-2.0",
  "private": true,
  "dependencies": {
    "@types/d3": "^7.4.0",
    "cross-env": "^7.0.3",
    "d3": "^7.8.4",
    "d3-scale": "^3.0.0",
    "gh-pages": "^6.0.0",
    "lit": "^2.8.0",
    "parcel": "^2.8.3"
  },
  "scripts": {
    "clean": "find static -maxdepth 1 -type f ! -name 'CNAME' ! -name '*.pdf' -delete && rm -rf dist",
    "prewatch": "yarn clean",
    "watch": "cross-env NODE_ENV=development parcel index.html --dist-dir=./static",
    "prebuild": "yarn clean",
    "build": "cross-env NODE_ENV=production parcel build index.html --public-url ./ --dist-dir=./static",
    "link-local": "yalc link",
    "predeploy": "yarn run build && cp CNAME static/CNAME",
    "deploy": "gh-pages -d static"
  },
  "devDependencies": {
    "process": "^0.11.10",
    "typescript": "5.0.2"
  },
  "homepage": "https://emilyreif.com"
}
